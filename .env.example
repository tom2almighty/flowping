# hub 监听地址
FLOWPING_LISTEN=:8080
# 数据目录（SQLite 数据库、已安装主题）
FLOWPING_DATA=./data
# hub 对外地址，用于生成 agent 部署命令和 GitHub 登录回调
FLOWPING_BASE_URL=https://ping.example.com
# 首次启动时写入的管理员密码；留空则自动生成并打印到日志
FLOWPING_ADMIN_PASSWORD=
# GitHub OAuth 应用（可选），回调地址填 $FLOWPING_BASE_URL/api/v1/auth/github/callback
FLOWPING_GITHUB_CLIENT_ID=
FLOWPING_GITHUB_CLIENT_SECRET=
# 经过 Cloudflare / nginx 反代时设为 true，从代理头读取 agent 真实 IP
FLOWPING_TRUST_PROXY=false
# agent 镜像与发布下载地址，自建镜像或国内加速时修改
FLOWPING_AGENT_IMAGE=ghcr.io/tom2almighty/flowping-agent
FLOWPING_RELEASE_URL=https://github.com/tom2almighty/flowping/releases/latest/download
# 日志级别 debug|info|warn|error
FLOWPING_LOG_LEVEL=info
